# Copy to .env (never commit it) and fill in.

# Hostname users open in the browser while on the VPN. Create a Cloudflare
# A record CHAT_DOMAIN -> WG_SERVER_IP with the proxy OFF (grey cloud).
CHAT_DOMAIN=chat.example.com
ACME_EMAIL=you@example.com
# Cloudflare API token scoped to Zone:DNS:Edit on that one zone only.
CF_API_TOKEN=

# Public hostname or IP that phones connect to (UDP 51820, port-forwarded
# on your router). A DNS-only Cloudflare record pointing at your home IP works.
WG_ENDPOINT_HOST=vpn.example.com
VPN_CIDR=10.8.0.0/24
WG_SERVER_IP=10.8.0.1

# wg-easy admin UI: published only on this address (your Tailscale IP).
WG_ADMIN_BIND=100.122.155.45
WG_ADMIN_USER=admin
# Used on first start only. Use a long random value, then delete this line
# and set WG_INIT_ENABLED=false.
WG_ADMIN_PASSWORD=
WG_INIT_ENABLED=true
